extends Node
## AudioManager (autoload): music, layered ambience and sound effects with fades.
## All sounds are generated by tools/generate_audio.py (original, CC0).

const AUDIO_DIR := "res://assets/audio/"
const AMBIENCE_LAYERS := ["fan", "crt_hum", "fluorescent", "murmur", "interference"]
const SILENT_DB := -60.0

var _streams: Dictionary = {}
var _missing: Dictionary = {}
var _ambience: Dictionary = {}   # layer -> AudioStreamPlayer
var _ambience_tweens: Dictionary = {}
var _music: AudioStreamPlayer
var _music_tween: Tween
var _music_name: String = ""
var _sfx_pool: Array[AudioStreamPlayer] = []
var _sfx_index: int = 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus: String in ["Music", "SFX", "Ambience"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var idx: int = AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, bus)
			AudioServer.set_bus_send(idx, "Master")
	for layer: String in AMBIENCE_LAYERS:
		var p := AudioStreamPlayer.new()
		p.bus = "Ambience"
		p.volume_db = SILENT_DB
		add_child(p)
		_ambience[layer] = p
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	_music.volume_db = SILENT_DB
	add_child(_music)
	for i: int in 8:
		var s := AudioStreamPlayer.new()
		s.bus = "SFX"
		add_child(s)
		_sfx_pool.append(s)


func _get_stream(sound: String, looped: bool = false) -> AudioStream:
	var key: String = sound + ("#loop" if looped else "")
	if _streams.has(key):
		return _streams[key]
	var path: String = AUDIO_DIR + sound + ".wav"
	if not ResourceLoader.exists(path):
		if not _missing.has(sound):
			_missing[sound] = true
			push_warning("AudioManager: missing sound '%s' (run tools/generate_audio.py)" % sound)
		return null
	var stream: AudioStream = load(path) as AudioStream
	if looped and stream is AudioStreamWAV:
		var w: AudioStreamWAV = (stream as AudioStreamWAV).duplicate() as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
		stream = w
	_streams[key] = stream
	return stream


func apply_volumes() -> void:
	var s: Dictionary = SaveManager.settings
	_set_bus("Master", float(s.get("master_volume", 0.8)))
	_set_bus("Music", float(s.get("music_volume", 0.6)))
	_set_bus("SFX", float(s.get("sfx_volume", 0.8)))
	_set_bus("Ambience", float(s.get("sfx_volume", 0.8)))


func _set_bus(bus: String, linear: float) -> void:
	var idx: int = AudioServer.get_bus_index(bus)
	if idx == -1:
		return
	AudioServer.set_bus_mute(idx, linear <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(linear, 0.001)))


# ---------------------------------------------------------------- sfx

func play_sfx(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var stream: AudioStream = _get_stream(sound)
	if stream == null:
		return
	var p: AudioStreamPlayer = _sfx_pool[_sfx_index]
	_sfx_index = (_sfx_index + 1) % _sfx_pool.size()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


## One keystroke, randomly chosen and pitched.
func play_key() -> void:
	play_sfx("key%d" % (1 + randi() % 3), -8.0, randf_range(0.92, 1.08))


# ---------------------------------------------------------------- ambience

## levels: {layer_name: volume_db}. Layers not listed fade to silence.
func set_ambience(levels: Dictionary, fade: float = 1.5) -> void:
	for layer: String in AMBIENCE_LAYERS:
		var target: float = float(levels.get(layer, SILENT_DB))
		var p: AudioStreamPlayer = _ambience[layer]
		if target > SILENT_DB and not p.playing:
			var st: AudioStream = _get_stream(layer, true)
			if st == null:
				continue
			p.stream = st
			p.play()
		if _ambience_tweens.has(layer) and (_ambience_tweens[layer] as Tween).is_valid():
			(_ambience_tweens[layer] as Tween).kill()
		var tw: Tween = create_tween()
		tw.tween_property(p, "volume_db", target, maxf(fade, 0.01))
		if target <= SILENT_DB:
			tw.tween_callback(p.stop)
		_ambience_tweens[layer] = tw


## Unnatural silence: everything drops out.
func silence(fade: float = 0.3) -> void:
	set_ambience({}, fade)
	stop_music(fade)


func apply_preset(preset: String, fade: float = 1.5) -> void:
	match preset:
		"menu":
			set_ambience({"crt_hum": -20.0, "fan": -26.0}, fade)
		"office":
			set_ambience({"fluorescent": -20.0, "murmur": -22.0, "fan": -30.0}, fade)
		"office_empty":
			set_ambience({"fluorescent": -18.0}, fade)
		"office_dead":
			set_ambience({"fluorescent": -30.0}, fade)
		"desktop":
			set_ambience({"fan": -16.0, "crt_hum": -22.0, "murmur": -34.0}, fade)
		"desktop_wrong":
			set_ambience({"fan": -18.0, "crt_hum": -18.0, "interference": -34.0}, fade)
		"desktop_dead":
			set_ambience({"crt_hum": -26.0}, fade)
		_:
			set_ambience({}, fade)


# ---------------------------------------------------------------- music

func play_music(track: String, volume_db: float = -14.0, fade: float = 3.0) -> void:
	if _music_name == track and _music.playing:
		return
	var st: AudioStream = _get_stream(track, true)
	if st == null:
		return
	_music_name = track
	_music.stream = st
	_music.volume_db = SILENT_DB
	_music.play()
	if _music_tween != null and _music_tween.is_valid():
		_music_tween.kill()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", volume_db, maxf(fade, 0.01))


func stop_music(fade: float = 2.0) -> void:
	if not _music.playing:
		return
	_music_name = ""
	if _music_tween != null and _music_tween.is_valid():
		_music_tween.kill()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", SILENT_DB, maxf(fade, 0.01))
	_music_tween.tween_callback(_music.stop)
